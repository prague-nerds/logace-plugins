{
  "manifestVersion": 1,
  "id": "logcat.source",
  "version": "1.0.2",
  "displayName": "Android device (logcat)",
  "description": "Android logcat snapshots and live streams through adb.",
  "kind": "source",
  "entryPoint": "LogAce.Plugins.Logcat.LogcatSourcePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "sources": [
    "AdbDeviceCatalog.cs",
    "AdbDeviceListEntry.cs",
    "AdbPackageCatalog.cs",
    "Browse.cs",
    "BrowseOption.cs",
    "Configuration.cs",
    "LogcatBuffer.cs",
    "LogcatDisplayPathFormatting.cs",
    "LogcatFollowSession.cs",
    "LogcatLevel.cs",
    "LogcatOpenMode.cs",
    "LogcatOptionTokens.cs",
    "LogcatSourceFactory.cs",
    "LogcatSourceOptions.cs",
    "SourceRuntime.cs",
    "TemporaryFileLifetime.cs",
    "plugin.cs"
  ],
  "capabilities": [
    "ProvideSourceConfigurationUi",
    "RunsProcesses",
    "UsesNetwork",
    "ReadsLocalFiles",
    "WritesLocalFiles"
  ],
  "packages": [],
  "ui": {
    "modes": [
      "declarativeForm"
    ]
  },
  "requiredParsers": [
    "logcat"
  ]
}
