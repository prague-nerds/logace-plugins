{
  "manifestVersion": 1,
  "id": "journalctl.source",
  "version": "1.0.1",
  "displayName": "Journalctl service",
  "description": "Local systemd journal snapshots and live streams through journalctl.",
  "kind": "source",
  "entryPoint": "LogAce.Plugins.Journalctl.JournalctlSourcePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "sources": [
    "Browse.cs",
    "BrowseOption.cs",
    "Configuration.cs",
    "JournalctlServiceCatalog.cs",
    "JournalctlServiceListEntry.cs",
    "JournalctlSinceArgumentBuilder.cs",
    "JournalctlSourceFactory.cs",
    "JournalctlSourceOptions.cs",
    "SourceRuntime.cs",
    "TemporaryFileLifetime.cs",
    "plugin.cs"
  ],
  "capabilities": [
    "ProvideSourceConfigurationUi",
    "RunsProcesses",
    "ReadsLocalFiles",
    "WritesLocalFiles"
  ],
  "packages": [],
  "ui": {
    "modes": [
      "declarativeForm"
    ]
  }
}
