{
  "manifestVersion": 1,
  "id": "otel.source",
  "version": "1.0.1",
  "displayName": "OpenTelemetry logs",
  "description": "Receive OpenTelemetry logs over OTLP/HTTP as JSON or protobuf.",
  "kind": "source",
  "entryPoint": "LogAce.Plugins.Otel.OtelSourcePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "sources": [
    "Configuration.cs",
    "OtelLogBatchNormalizer.cs",
    "OtelLogSourceFactory.cs",
    "OtelLogSourceOptions.cs",
    "SourceRuntime.cs",
    "TemporaryFileLifetime.cs",
    "plugin.cs"
  ],
  "capabilities": [
    "ProvideSourceConfigurationUi",
    "UsesNetwork",
    "ReadsLocalFiles",
    "WritesLocalFiles"
  ],
  "packages": [],
  "ui": {
    "modes": [
      "declarativeForm"
    ]
  }
}
