{
  "manifestVersion": 1,
  "id": "oslog.source",
  "version": "1.0.1",
  "displayName": "macOS unified log",
  "description": "Host macOS unified log snapshots and live streams through the log command.",
  "kind": "source",
  "entryPoint": "LogAce.Plugins.OsLog.OsLogSourcePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "sources": [
    "Browse.cs",
    "BrowseOption.cs",
    "Configuration.cs",
    "OsLogDisplayPathFormatting.cs",
    "OsLogFacet.cs",
    "OsLogFacetCatalog.cs",
    "OsLogFacetKind.cs",
    "OsLogFollowSession.cs",
    "OsLogLevel.cs",
    "OsLogOpenMode.cs",
    "OsLogSourceFactory.cs",
    "OsLogSourceOptions.cs",
    "SourceRuntime.cs",
    "TemporaryFileLifetime.cs",
    "plugin.cs"
  ],
  "capabilities": [
    "ProvideSourceConfigurationUi",
    "RunsProcesses",
    "ReadsLocalFiles",
    "WritesLocalFiles"
  ],
  "packages": [],
  "ui": {
    "modes": [
      "declarativeForm"
    ]
  }
}
