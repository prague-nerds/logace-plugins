{
  "manifestVersion": 1,
  "id": "azure.source",
  "version": "1.0.1",
  "displayName": "Azure logs",
  "description": "Azure App Service streams and Log Analytics queries through Azure CLI.",
  "kind": "source",
  "entryPoint": "LogAce.Plugins.Azure.AzureSourcePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "sources": [
    "AzureAppServiceOptions.cs",
    "AzureAppServiceSourceFactory.cs",
    "AzureLogAnalyticsOptions.cs",
    "AzureLogAnalyticsSourceFactory.cs",
    "CliLineFollowSession.cs",
    "CloudCliProcess.cs",
    "Configuration.cs",
    "IStreamingOutputTransformer.cs",
    "JsonStreamToNdjsonTransformer.cs",
    "PlainTextOutputTransformer.cs",
    "SourceRuntime.cs",
    "TemporaryFileLifetime.cs",
    "plugin.cs"
  ],
  "capabilities": [
    "ProvideSourceConfigurationUi",
    "RunsProcesses",
    "UsesNetwork",
    "ReadsLocalFiles",
    "WritesLocalFiles"
  ],
  "packages": [],
  "ui": {
    "modes": [
      "declarativeForm"
    ]
  }
}
